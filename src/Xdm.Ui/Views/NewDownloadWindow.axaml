<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Xdm.Ui.Controls"
        xmlns:vm="using:Xdm.Ui.ViewModels"
        x:Class="Xdm.Ui.Views.NewDownloadWindow"
        x:DataType="vm:NewDownloadViewModel"
        Title="新建下载"
        Icon="/Assets/xdm-logo.png"
        Width="580" Height="500"
        MinWidth="480" MinHeight="400"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterOwner">

  <DockPanel>

    <controls:TitleBar DockPanel.Dock="Top" Title="新建下载" ShowMaximize="False" ShowMinimize="False" />

    <DockPanel Margin="16">

      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right"
                  Margin="0,12,0,0">
        <TextBlock Text="{Binding ErrorText}"
                   Foreground="{DynamicResource ErrorBrush}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   IsVisible="{Binding HasError}" />
        <Button x:Name="CancelButton"
                AutomationProperties.Name="取消"
                MinWidth="80"
                Click="OnCancelClick">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <PathIcon Width="12" Height="12"
                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
            <TextBlock Text="取消" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Content="添加" MinWidth="80" Classes="accent" Click="OnAddClick" />
      </StackPanel>

      <TabControl>
        <TabItem Header="链接">
          <Grid RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                ColumnDefinitions="90,*"
                Margin="8,12">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="链接" FontSize="12" VerticalAlignment="Top" Margin="0,6,0,0" />
            <controls:EditTextBox Grid.Row="0" Grid.Column="1"
                     x:Name="UrlBox"
                     Text="{Binding Urls}"
                     AcceptsReturn="True"
                     Height="110"
                     FontSize="12"
                     TextWrapping="Wrap"
                     PlaceholderText="每行一个 http/https 链接" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="保存到" FontSize="12" VerticalAlignment="Center" />
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
              <controls:EditTextBox Text="{Binding SaveFolder}" FontSize="12" />
              <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseClick" />
            </Grid>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="文件名" FontSize="12" VerticalAlignment="Center" />
            <controls:EditTextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding FileName}"
                     FontSize="12"
                     PlaceholderText="留空则按链接自动推导（仅单链接生效）" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="分段数" FontSize="12" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="6" Grid.Column="1"
                           Width="140" HorizontalAlignment="Left"
                           Minimum="1" Maximum="256" Increment="1"
                           FormatString="0"
                           Value="{Binding Segments}" />

            <CheckBox Grid.Row="8" Grid.Column="1"
                      Content="立即开始"
                      FontSize="12"
                      IsChecked="{Binding StartImmediately}" />

            <TextBlock Grid.Row="10" Grid.Column="1"
                       Text="一期只支持 HTTP / HTTPS 直链（每行一个）；HuggingFace 与 BT 后续版本再加。"
                       FontSize="11"
                       Opacity="0.5"
                       TextWrapping="Wrap" />
          </Grid>
        </TabItem>
      </TabControl>

    </DockPanel>

  </DockPanel>

</Window>
