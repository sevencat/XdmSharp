<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Xdm.Ui.Controls"
        x:Class="Xdm.Ui.Views.ConfirmDialog"
        Title="请确认"
        Icon="/Assets/xdm-logo.png"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterOwner">

  <DockPanel>

    <controls:TitleBar x:Name="Bar"
                       DockPanel.Dock="Top"
                       Title="请确认"
                       ShowMaximize="False"
                       ShowMinimize="False" />

    <StackPanel Margin="20,18,20,16" Spacing="18">

      <TextBlock x:Name="MessageText"
                 FontSize="13"
                 TextWrapping="Wrap"
                 LineHeight="20" />

      <CheckBox x:Name="OptionCheck"
                AutomationProperties.Name="同时删除已下载的文件"
                IsVisible="False" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton"
                AutomationProperties.Name="取消"
                MinWidth="84"
                IsCancel="True"
                Click="OnCancelClick">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <PathIcon Width="12" Height="12"
                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
            <TextBlock x:Name="CancelText" Text="取消" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="OkButton"
                AutomationProperties.Name="确定"
                MinWidth="84"
                Classes="accent"
                IsDefault="True"
                Click="OnOkClick">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <PathIcon Width="12" Height="12"
                      Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" />
            <TextBlock x:Name="OkText" Text="确定" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

    </StackPanel>

  </DockPanel>

</Window>
