<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Xdm.Ui.Controls"
        xmlns:vm="using:Xdm.Ui.ViewModels"
        x:Class="Xdm.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="XDM Sharp"
        Icon="/Assets/xdm-logo.png"
        Width="1000" Height="620"
        MinWidth="720" MinHeight="420"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.row-action">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.row-action">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected Button.row-action">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- 自绘标题栏 30px（系统 chrome 由 WindowDecorations="BorderOnly" 关掉） -->
    <controls:TitleBar DockPanel.Dock="Top" Title="XDM Sharp" />

    <!-- 工具栏 40px -->
    <Border DockPanel.Dock="Top"
            Height="40"
            Padding="8,0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="NewButton"
                  Classes="accent tool"
                  AutomationProperties.Name="新建"
                  Click="OnNewDownloadClick">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19Z" Width="12" Height="12" />
              <TextBlock Text="新建" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool"
                  AutomationProperties.Name="恢复"
                  Command="{Binding ResumeSelectedCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="M8,5.14V19.14L19,12.14Z" Width="12" Height="12" />
              <TextBlock Text="恢复" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool"
                  AutomationProperties.Name="暂停"
                  Command="{Binding PauseSelectedCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="M14,19H18V5H14V19M6,19H10V5H6V19Z" Width="12" Height="12" />
              <TextBlock Text="暂停" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool"
                  AutomationProperties.Name="删除"
                  Command="{Binding DeleteSelectedCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                        Width="12" Height="12" />
              <TextBlock Text="删除" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <controls:EditTextBox x:Name="SearchBox"
                 Grid.Column="1"
                 Width="260"
                 FontSize="12"
                 PlaceholderText="搜索文件名或链接"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Text="{Binding SearchText}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="SettingsButton"
                  Classes="tool"
                  AutomationProperties.Name="设置"
                  Click="OnSettingsClick">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Width="12" Height="12"
                        Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
              <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="AboutButton"
                  Classes="tool"
                  AutomationProperties.Name="关于"
                  Click="OnAboutClick">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Width="12" Height="12"
                        Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" />
              <TextBlock Text="关于" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ExitButton"
                  Classes="tool"
                  AutomationProperties.Name="退出"
                  Click="OnExitClick">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Width="12" Height="12"
                        Data="M16,17V14H9V10H16V7L21,12L16,17M14,2H4A2,2 0 0,0 2,4V20A2,2 0 0,0 4,22H14A2,2 0 0,0 16,20V17H14V20H4V4H14V7H16V4A2,2 0 0,0 14,2Z" />
              <TextBlock Text="退出" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 状态栏 24px -->
    <Border DockPanel.Dock="Bottom" Classes="stat">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding StatusSummary}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ListSummary}"
                   FontSize="12"
                   Opacity="0.6"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   x:Name="StatusText"
                   Text="{Binding DbPath, StringFormat='任务库：{0}'}"
                   FontSize="12"
                   Opacity="0.7"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 左侧分类 180px -->
    <Border DockPanel.Dock="Left"
            Width="180"
            Padding="0,8"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ListBox x:Name="CategoryList"
               ItemsSource="{Binding Categories}"
               SelectedItem="{Binding SelectedCategory}"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="8,7">
              <TextBlock Text="{Binding Name}" FontSize="13" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Count}"
                         FontSize="12"
                         Opacity="0.55"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- 主列表 -->
    <Grid>
      <ListBox x:Name="TaskList"
               ItemsSource="{Binding Rows}"
               SelectedItem="{Binding SelectedRow}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.IsDeferredScrollingEnabled="False">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <controls:DownloadRow />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="暂无下载任务"
                 FontSize="13"
                 Opacity="0.45"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding IsEmpty}" />
    </Grid>

  </DockPanel>

</Window>
