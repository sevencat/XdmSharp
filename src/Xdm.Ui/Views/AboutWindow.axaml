<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Xdm.Ui.Controls"
        x:Class="Xdm.Ui.Views.AboutWindow"
        Title="关于 XDM Sharp"
        Icon="/Assets/xdm-logo.png"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterOwner">

  <DockPanel>

    <controls:TitleBar DockPanel.Dock="Top" Title="关于" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Margin="24,20,24,18" Spacing="12">

      <StackPanel Orientation="Horizontal" Spacing="14">
        <Image Source="/Assets/xdm-logo.png" Width="52" Height="52" Stretch="Uniform" />
        <StackPanel VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="XDM Sharp" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.6" />
        </StackPanel>
      </StackPanel>

      <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19"
                 Text="Windows 桌面多线程下载工具：HTTP / HTTPS 分段下载、断点续传、限速与任务队列。" />

      <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19" Opacity="0.62"
                 Text="参考 XDM（Kotlin / Swing，GPL-3.0-or-later）重写为 C# + Avalonia，本程序同样以 GPL-3.0 发布。" />

      <TextBlock FontSize="11" Opacity="0.5"
                 Text=".NET 10 · Avalonia 12 · SimdAIO · PureDb" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button x:Name="CloseButton"
                AutomationProperties.Name="关闭"
                MinWidth="84"
                IsDefault="True"
                IsCancel="True"
                Click="OnCloseClick">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <PathIcon Width="12" Height="12"
                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
            <TextBlock Text="关闭" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

    </StackPanel>

  </DockPanel>

</Window>
