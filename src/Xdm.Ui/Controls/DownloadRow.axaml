<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Xdm.Ui.Controls"
             xmlns:vm="using:Xdm.Ui.ViewModels"
             x:Class="Xdm.Ui.Controls.DownloadRow"
             x:DataType="vm:DownloadRowViewModel">

  <UserControl.Styles>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.badge.completed">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.badge.completed TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.badge.failed">
      <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.badge.failed TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.row-action">
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Border BorderThickness="0,0,0,1"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <Grid ColumnDefinitions="28,*,Auto"
          RowDefinitions="Auto,Auto"
          MinHeight="56"
          Margin="12,6"
          ToolTip.Tip="{Binding ToolTipText}">

      <Border Grid.RowSpan="2"
              Width="24" Height="24"
              CornerRadius="4"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <TextBlock Text="{Binding Extension}"
                   FontSize="9"
                   FontWeight="SemiBold"
                   Opacity="0.75"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <TextBlock Grid.Column="1"
                 Text="{Binding FileName}"
                 FontSize="13"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />

      <TextBlock Grid.Column="2"
                 Text="{Binding SizeText}"
                 FontSize="11"
                 Opacity="0.7"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Row="1" Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  Margin="0,6,0,0"
                  VerticalAlignment="Center">
        <controls:SegmentBar Width="140" Height="4"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ShowProgress}"
                             Value="{Binding Progress}"
                             Segments="{Binding Segments}"
                             Fill="{DynamicResource ProgressBrush}"
                             Track="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <TextBlock Text="{Binding ProgressText}"
                   FontSize="11"
                   Opacity="0.75"
                   Width="34"
                   IsVisible="{Binding ShowProgress}" />
        <TextBlock Text="{Binding SegmentAndFolderText}"
                   FontSize="11"
                   Opacity="0.55"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  Margin="8,6,0,0"
                  VerticalAlignment="Center">
        <TextBlock Text="{Binding SpeedText}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
        <TextBlock Text="{Binding RemainingText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
        <Border Classes="badge"
                Classes.completed="{Binding IsCompleted}"
                Classes.failed="{Binding IsFailed}">
          <TextBlock Text="{Binding StatusText}" />
        </Border>
        <Button Classes="row-action"
                Content="{Binding ToggleText}"
                Command="{Binding TogglePauseCommand}"
                IsVisible="{Binding !IsCompleted}" />
        <Button Classes="row-action"
                Content="目录"
                Command="{Binding OpenFolderCommand}" />
        <Button Classes="row-action"
                Content="删除"
                Command="{Binding DeleteCommand}" />
      </StackPanel>

    </Grid>
  </Border>
</UserControl>
