<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Xdm.App</RootNamespace>
    <AssemblyName>xdm-app</AssemblyName>
    <!-- 资源管理器 / 任务栏用的 exe 图标（根目录 logo.png 处理成多尺寸 ico） -->
    <ApplicationIcon>Assets\xdm.ico</ApplicationIcon>
    <!-- 本工程是唯一的启动栈所在：AIO = Avalonia 核心 + SimdSkia 合并包（ARCHITECTURE.md §2.1） -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- NativeAOT 只支持 win-x64（SimdAIO 的 RID 约束）：单文件原生 exe，不依赖 .NET 运行时 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 不产出 .pdb（原生符号近 100 MB，发布包里没用；排障时单独关掉这一项） -->
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Sevencat.Avalonia.SimdAIO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xdm.Ui\Xdm.Ui.csproj" />
    <ProjectReference Include="..\Xdm.Core\Xdm.Core.csproj" />
  </ItemGroup>

<!--
    发布目录里的 xdm-app.pdb 是 ILC 生成的原生符号（约 118 MB），只在排查 native crash 时有用。
    MSBuild 的 AfterTargets="Publish" 早于符号拷贝，删不到；由 build.ps1 -Aot 在发布后清理，
    或手动 delete publish\win-x64-aot\*.pdb。
  -->

</Project>
