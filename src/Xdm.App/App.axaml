<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Xdm.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <!-- 语义色（UI-DESIGN.md §1）：行内进度、状态徽标都从这里取，主题切换只改这里 -->
    <SolidColorBrush x:Key="ProgressBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E9E4F" />
    <SolidColorBrush x:Key="WarnBrush" Color="#D98B00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D64545" />
  </Application.Resources>

  <Application.Styles>
    <!-- FluentTheme 由 Sevencat.Avalonia.SimdAIO 附带（独立程序集身份），不要再引官方 Themes.Fluent 包 -->
    <FluentTheme />
  </Application.Styles>
</Application>
